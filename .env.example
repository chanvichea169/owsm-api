# Compose loads .env automatically. Never put live credentials in this example file.
# Copy this file to .env, then set each value locally.
JWT_SECRET=
MAIL_USERNAME=
MAIL_PASSWORD=
REDIS_PASSWORD=
# Use a newly rotated Telegram bot token. Keep it backend-only.
TELEGRAM_BOT_TOKEN=
# Optional polling interval in milliseconds for receiving Telegram updates (default 3000).
TELEGRAM_POLL_INTERVAL_MS=3000
# Telegram group/supergroup chat id that receives delete and risk alerts (e.g. -1001234567890).
TELEGRAM_ALERT_CHAT_ID=
